# Copie para backend/.env e ajuste. NUNCA commite o .env com a senha real.
# Este arquivo serve para rodar seed.py / uvicorn FORA do Docker no Mac.
# O `docker compose` NÃO lê este arquivo: ele lê o .env da RAIZ do repo
# (cp .env.example .env). Use a MESMA senha nos dois arquivos.
POSTGRES_DB=quantum
POSTGRES_USER=quantum
POSTGRES_PASSWORD=troque-esta-senha

# URL usada pela API quando roda FORA do docker (uvicorn local).
# Dentro do compose, o serviço `api` usa o host `db` (ver docker-compose.yml).
DATABASE_URL=postgresql+psycopg://quantum:troque-esta-senha@localhost:5432/quantum

# Sem Postgres (testes locais / fallback): USE_SQLITE=1 usa backend/app.db
# USE_SQLITE=1

# Resumo com IA (GET /products/{id}/summary): chave do Google AI Studio.
# Sem ela, o endpoint devolve o resumo determinístico (nunca quebra).
# No Docker, a chave chega ao container via docker-compose.yml
# (interpolação ${GEMINI_API_KEY} do .env da RAIZ do repo).
GEMINI_API_KEY=
# Modelo usado no resumo (padrão: gemini-3.8-flash, verificado em 31/out/2026).
# GEMINI_MODEL=gemini-3.8-flash
