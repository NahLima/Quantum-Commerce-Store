# Copie para .env e ajuste. NUNCA commite o .env com a senha real.
# Uso local (Mac): docker compose up --build
POSTGRES_DB=quantum
POSTGRES_USER=quantum
POSTGRES_PASSWORD=troque-esta-senha

# URL usada pela API quando roda FORA do docker (uvicorn local).
# Dentro do compose, o serviço `api` usa o host `db` (ver docker-compose.yml).
DATABASE_URL=postgresql+psycopg://quantum:troque-esta-senha@localhost:5432/quantum

# Sem Postgres (testes locais / fallback): USE_SQLITE=1 usa backend/app.db
# USE_SQLITE=1
