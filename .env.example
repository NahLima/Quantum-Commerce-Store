# Copie para .env (NA RAIZ do repo) e ajuste a senha. NUNCA commite o .env.
# Este é o arquivo que o `docker compose` lê para interpolar o
# docker-compose.yml (senha do Postgres + DATABASE_URL da API).
# O backend/.env é SEPARADO: só serve para rodar seed.py / uvicorn
# fora do Docker no Mac — use a MESMA senha nos dois.
POSTGRES_DB=quantum
POSTGRES_USER=quantum
POSTGRES_PASSWORD=troque-esta-senha

# Resumo com IA: chave do Google AI Studio, interpolada no docker-compose.yml
# para o container da API. Sem ela, o resumo fica na versão determinística.
GEMINI_API_KEY=
